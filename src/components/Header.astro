---
import { getCollection } from "astro:content";
import { locales, type Locale } from "../i18n/config";
import { localeFromEntryId } from "../i18n/content";
import { localizedPath, type RouteId } from "../i18n/routes";

interface Props {
  currentLang: Locale;
  currentRoute: RouteId;
  isDarkmode?: boolean;
  isAbsolute?: boolean;
}

const {
  currentLang,
  currentRoute,
  isDarkmode = false,
  isAbsolute = true,
} = Astro.props;

const allEntries = await getCollection("header");

const entryData = allEntries.find(
  (page) => localeFromEntryId(page.id) === currentLang,
)?.data;

if (!entryData) {
  throw new Error(
    `No se encontró la colección 'header' para el idioma: ${currentLang}`,
  );
}

const homeHref = localizedPath(currentLang, "home");

const navLinks = [
  {
    route: "about",
    href: localizedPath(currentLang, "about"),
    label: entryData["about-me"],
  },
  {
    route: "projects",
    href: localizedPath(currentLang, "projects"),
    label: entryData.projects,
  },
  {
    route: "stack",
    href: localizedPath(currentLang, "stack"),
    label: entryData.stack,
  },
] satisfies Array<{ route: RouteId; href: string; label: string }>;
---

<div
  class:list={[
    "w-full flex flex-col z-10 py-4 px-2 lg:p-14",
    isAbsolute && "absolute",
    isDarkmode ? "text-foreground" : "text-secondary_light",
  ]}
>
  <div
    class="flex md:justify-end items-center text-lg md:text-2xl font-sans flex-wrap"
  >
    <div class="w-full md:w-5/6 flex justify-between items-center">
      <div class="mx-2 flex items-center gap-2 md:mx-4 md:mr-auto">
        <a
          href={homeHref}
          class:list={[
            "cursor-pointer transition-colors duration-300",
            isDarkmode
              ? "hover:text-secondary"
              : "text-principal hover:text-secondary_light",
          ]}
          aria-label={entryData.home}
        >
          ektl.dev
        </a>
      </div>

      {
        navLinks.map((link) => (
          <a
            class:list={[
              "cursor-pointer mx-2 sm:mx-4 font-bold hover:text-secondary_light duration-300",
              currentRoute === link.route &&
                isDarkmode &&
                "text-secondary_light",
              currentRoute === link.route && !isDarkmode && "text-principal",
            ]}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="w-full md:w-1/6">
      <div class="mt-4 ml-auto sm:m-0 sm:mx-4 mr-auto">
        {
          locales.map((language) => (
            <a
              class:list={[
                "mr-1 cursor-pointer hover:text-secondary_light transition-all duration-300",
                currentLang === language &&
                  isDarkmode &&
                  "text-secondary_light",
                currentLang === language && !isDarkmode && "text-principal",
              ]}
              href={localizedPath(language, currentRoute)}
            >
              [ {language} ]
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>
