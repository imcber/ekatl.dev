---
import ProjectCard from "./ProjectCard.astro";
import ContextualBack from "../ContextualBack.astro";
import type { Locale } from "../../i18n/config";

export interface Project {
  id: string;
  name: string;
  about: string;
  task: string;
  year: string;
  rol: string;
  url: string;
  tags: string[];
}

interface ProjectsEntries {
  title_page: string;
  title_year: string;
  title_rol: string;
  title_about: string;
  title_task: string;
  title_visit_site: string;
  work: Project[];
}

interface Props {
  projectsEntries: ProjectsEntries;
  currentLang: Locale;
}

const { projectsEntries, currentLang } = Astro.props;
---

<div class="w-full px-4 md:px-7 py-10">
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center lg:items-start lg:px-20"
  >
    <ContextualBack currentLang={currentLang} />
    <p class="text-5xl font-extrabold mb-2">
      {projectsEntries.title_page}
    </p>
  </div>
  <div class="w-full flex justify-center items-center py-5">
    <div
      class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-200 px-3 md:p-0 max-w-7xl"
    >
      {
        projectsEntries?.work.map((project) => (
          <ProjectCard
            project={project}
            visitSiteLabel={projectsEntries.title_visit_site}
          />
        ))
      }
    </div>
  </div>
</div>
