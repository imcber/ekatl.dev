---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import AboutMeComponent from "../../components/About/AboutMe.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { createLocalizedPaths } from "../../i18n/content";
import { parseLocale } from "../../i18n/config";

export async function getStaticPaths() {
  return createLocalizedPaths(await getCollection("aboutMe"));
}

interface Props {
  page: CollectionEntry<"aboutMe">;
}

const lang = parseLocale(Astro.params.lang);
const { page } = Astro.props;
---

<Layout currentLang={lang} currentRoute="about">
  <Header currentLang={lang} currentRoute="about" isDarkmode />
  <AboutMeComponent aboutMe={page.data} currentLang={lang} />
</Layout>
