---
import Header from "../../components/Header.astro";
import StackContainer from "../../components/Stack/StackContainer.astro";
import Layout from "../../layouts/Layout.astro";
import { locales, parseLocale } from "../../i18n/config";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = parseLocale(Astro.params.lang);
---

<Layout currentLang={lang} currentRoute="stack">
  <Header currentLang={lang} currentRoute="stack" isAbsolute={false} />
  <StackContainer currentLang={lang} />
</Layout>
