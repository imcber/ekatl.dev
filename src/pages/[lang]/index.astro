---
import Contact from "../../components/Contact.astro";
import Header from "../../components/Header.astro";
import Welcome from "../../components/Home/Welcome.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { createLocalizedPaths } from "../../i18n/content";
import { parseLocale } from "../../i18n/config";
import { assetPath } from "../../i18n/routes";

export async function getStaticPaths() {
  return createLocalizedPaths(await getCollection("home"));
}

interface Props {
  page: CollectionEntry<"home">;
}

const lang = parseLocale(Astro.params.lang);
const { page } = Astro.props;
---

<Layout currentLang={lang} currentRoute="home">
  <Header currentLang={lang} currentRoute="home" />
  <Welcome greetings={page.data.greetings} />
  <Contact
    contact={page.data.contact}
    resumePath={assetPath(`resume/${lang}.pdf`)}
    resumeFilename={`Bernardo-Ramirez-CV-${lang.toUpperCase()}.pdf`}
  />
</Layout>
