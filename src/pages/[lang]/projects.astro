---
import Header from "../../components/Header.astro";
import ProjectContainer from "../../components/Projects/ProjectContainer.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { createLocalizedPaths } from "../../i18n/content";
import { parseLocale } from "../../i18n/config";

export async function getStaticPaths() {
  return createLocalizedPaths(await getCollection("projects"));
}

interface Props {
  page: CollectionEntry<"projects">;
}

const lang = parseLocale(Astro.params.lang);
const { page } = Astro.props;
---

<Layout currentLang={lang} currentRoute="projects">
  <Header currentLang={lang} currentRoute="projects" isAbsolute={false} />
  <ProjectContainer projectsEntries={page.data} currentLang={lang} />
</Layout>
