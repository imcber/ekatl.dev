---
import CommonHead from "../components/commons/CommonHead.astro";
import { homeTransition, screenTransition } from "../lib/screenTransition.mjs";
import type { Locale } from "../i18n/config";
import type { RouteId } from "../i18n/routes";
import "../styles/global.css";
import "../styles/screenAnimation.css";

interface Props {
  currentLang: Locale;
  currentRoute: RouteId;
}
const { currentLang, currentRoute } = Astro.props;
const pageTransition =
  currentRoute === "home" ? homeTransition : screenTransition;
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <CommonHead lang={currentLang} currentRoute={currentRoute} />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3GFXE31GD8"
    ></script><script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-3GFXE31GD8");
    </script></head
  >

  <body class="bg-foreground text-principal noise-container">
    <main
      transition:name="page-content"
      transition:animate={pageTransition}
      class="min-h-screen bg-foreground"
    >
      <slot />
    </main>
  </body>
</html>

<script>
  document.addEventListener("astro:before-swap", (event) => {
    const isContextualBack =
      document.documentElement.dataset.contextualBack === "true";

    delete document.documentElement.dataset.contextualBack;

    if (event.navigationType === "traverse" && !isContextualBack) {
      event.viewTransition.skipTransition();
    }
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  .noise-container {
    position: relative;
    color: white;
    text-align: center;
  }

  .noise-container::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><filter id="a" x="0" y="0" width="100%" height="100%"><feTurbulence baseFrequency=".2"/></filter><rect width="100%" height="100%" filter="url(%23a)"/></svg>');
    opacity: 0.06;

    animation: noiseAnimation 0.5s steps(2, end) infinite;
    pointer-events: none;
  }

  @keyframes noiseAnimation {
    0% {
      transform: translate(0, 0);
    }
    10% {
      transform: translate(0, -5%);
    }
    20% {
      transform: translate(0, -10%);
    }
    30% {
      transform: translate(0, -5%);
    }
    40% {
      transform: translate(0, -5%);
    }
    50% {
      transform: translate(0, -10%);
    }
    60% {
      transform: translate(0, -15%);
    }
    70% {
      transform: translate(0, 0);
    }
    80% {
      transform: translate(0, -15%);
    }
    90% {
      transform: translate(0, -10%);
    }
    100% {
      transform: translate(0, -5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .noise-container::after {
      animation: none;
    }
  }
</style>
